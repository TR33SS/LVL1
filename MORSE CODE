#include <WiFi.h>
#include <WebServer.h>

// Wi-Fi credentials
const char* ssid = "your_wifi_ssid";             // Replace with your Wi-Fi SSID
const char* password = "your_wifi_password";     // Replace with your Wi-Fi password

WebServer server(80);

#define LED_PIN 2  // Built-in LED (can be changed if using an external one)
const int dotDuration = 200;  // Duration of a dot in milliseconds

// Morse code dictionary for A-Z
const char* morseAlphabet[] = {
  ".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---",
  "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-",
  "..-", "...-", ".--", "-..-", "-.--", "--.."
};

// HTML page for user input
const char* htmlPage = R"=====( 
<!DOCTYPE html>
<html>
<head>
  <title>ESP32 Morse Code Sender</title>
  <style>
    body { font-family: Arial; text-align: center; padding-top: 40px; }
    input[type="text"] { padding: 10px; width: 300px; }
    input[type="submit"] { padding: 10px 20px; }
  </style>
</head>
<body>
  <h1>Send Morse Code via LED</h1>
  <form action="/send" method="POST">
    <input type="text" name="message" placeholder="Type message (A-Z only)" required>
    <input type="submit" value="Send">
  </form>
</body>
</html>
)=====";

// Convert a character to Morse code
String charToMorse(char c) {
  if (c >= 'a' && c <= 'z') {
    return morseAlphabet[c - 'a'];
  } else if (c >= 'A' && c <= 'Z') {
    return morseAlphabet[c - 'A'];
  } else if (c == ' ') {
    return " ";
  }
  return "";  // Ignore other characters
}

// Flash Morse code for a single character
void flashMorseChar(char c) {
  String morse = charToMorse(c);
  for (int i = 0; i < morse.length(); i++) {
    digitalWrite(LED_PIN, HIGH);
    if (morse[i] == '.') {
      delay(dotDuration);
    } else if (morse[i] == '-') {
      delay(dotDuration * 3);
    }
    digitalWrite(LED_PIN, LOW);
    delay(dotDuration);  // Space between elements
  }
  delay(dotDuration * 3);  // Space between letters
}

// Flash Morse code for the entire message
void flashMorseMessage(String message) {
  for (int i = 0; i < message.length(); i++) {
    if (message[i] == ' ') {
      delay(dotDuration * 7);  // Word gap
    } else {
      flashMorseChar(message[i]);
    }
  }
}

// Web server root
void handleRoot() {
  server.send(200, "text/html", htmlPage);
}

// Web server form handler
void handleSend() {
  String message = server.arg("message");
  Serial.print("Flashing message: ");
  Serial.println(message);
  flashMorseMessage(message);
  server.send(200, "text/html", "<h2>Message Sent in Morse Code</h2><a href='/'>Go Back</a>");
}

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);

  // Connect to Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nConnected to Wi-Fi");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Setup web server
  server.on("/", handleRoot);
  server.on("/send", HTTP_POST, handleSend);
  server.begin();
  Serial.println("Web server started");
}

void loop() {
  server.handleClient();
}
